# Python
__pycache__/
.pytest_cache/
*.py[cod]
*.egg-info/
.venv/
venv/
# 오프라인 설치용 wheel 모음 — report_server_zip.bat 가 압축할 때마다 새로 만든다.
# 약 70MB 의 바이너리라 git 에는 넣지 않는다 (ZIP 에는 포함된다).
server/wheelhouse/
env/
# server/env/ 는 파이썬 가상환경이 아니라 서버 기동 설정(server.env) 폴더 — 추적한다.
!server/env/

# PyInstaller build output (build_honey.spec is kept as source)
build/
dist/
*.manifest
*.log

# Honey ZIP release output
client/release_dist/

# Locally generated report xlsx (regenerated by the report_generator)
client/data/
client/data/*_report.xlsx

# Runtime artifacts (regenerated at runtime)
DB/
uploads/
tests/sample.xlsx

# web_report 벤치 결과 (로컬 PC 기준선 — bench_webreport.py 가 생성, PC 사양 종속이라 미추적)
tests/bench_results/

# Runtime logs (server/client console tee output)
server/log/
client/log/

# 프로파일러 산출물 (profile_run.py 가 생성)
client/_profiles/

# 기준정보 임포터 산출물 (Excel PC 에서 생성 → 서버로 수동 복사)
tools/product_info_import/output/

# eval 디버깅용 합성 테스트 데이터 (make_eval_testdata.py 가 생성 — parquet 6MB+)
tools/eval_testdata/out/

# MS Office lock/owner files (e.g. ~$sample.xlsx when opened in Excel)
~$*

# Honey release packages served by /honey/download, not version-controlled.
# version.json IS tracked; release_honey.ps1 drops ZIP packages here.
server/releases/*.exe
server/releases/*.zip

# 자동 업데이트 테스트 빌드 산출물 (client/update_test/README.md).
# 위 build/ · dist/ 패턴은 이름이 정확히 일치해야 걸리므로 따로 적는다.
client/build_launcher/
client/dist_launcher/
client/update_test/release/
client/update_test/build_server/
client/update_test/dist_server/

# Local Claude Code settings (personal, not shared)
.claude/settings.local.json
CLAUDE.core.md

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
