# ============================================================================
# report-server 기동 설정 — start.bat 과 watchdog.ps1 이 공통으로 읽는다.
# 여기가 정본이다. bat/ps1 안의 값을 고치지 말고 이 파일만 수정할 것.
#
#   형식 : KEY=VALUE   (값에 공백 금지 / '#' 로 시작하는 줄은 주석)
#   주의 : 반드시 BOM 없는 UTF-8 로 저장할 것.
#          (BOM 이 있으면 batch 가 첫 줄 키를 깨진 이름으로 읽는다)
#
# ── HOST : 서버가 bind 할 주소 ───────────────────────────────────────────────
#   0.0.0.0         이 PC 의 모든 IP 로 열기 (LAN 노출, 기본값)
#   12.81.220.117   운영 서버 IP 로만 열기
#                   ※ 그 IP 를 실제로 가진 PC 에서 실행할 때만 bind 된다.
#                      다른 PC 에서 이 값으로 두면 기동이 실패한다.
#   127.0.0.1       이 PC 에서만 접근 (로컬 전용, LAN 노출 없음)
#
# ── PORT : 수신 포트 ─────────────────────────────────────────────────────────
#   클라이언트(client/honey.env 의 HONEY_SERVER_URL)와 맞춰야 한다.
#
# ── SERVER_BASE_URL : 클라이언트가 실제로 접속하는 주소 ──────────────────────
#   HOST(=bind 주소)와 다른 값이다. HOST 는 "어느 랜카드로 들을지", 이 값은
#   "남들이 우리를 어떤 주소로 부르는지"다. 서버가 절대 URL 을 만들 때 쓴다.
#   운영 IP 가 바뀌면 이 값과 client/honey.env 의 HONEY_SERVER_URL 을 같이 고친다.
#
# ── WATCHDOG_MANAGE : start/terminate 가 watchdog 작업을 켜고 끌지 여부 ──────
#   1  (기본) terminate.bat 이 watchdog 을 잠시 끄고, start.bat 이 다시 켠다.
#             코드 교체 중 watchdog 이 옛 코드로 서버를 되살리는 것을 막는다.
#   0        watchdog 을 건드리지 않는다. 이 PC 에 watchdog 을 등록하지 않았거나,
#            schtasks 권한 문제로 메시지가 계속 거슬릴 때 사용.
#            ※ watchdog 자체를 끄는 게 아니라 "bat 이 관여하지 않는" 것이다.
#
# ── WAITRESS_THREADS : 동시에 처리할 요청 스레드 수 ──────────────────────────
#   기본 13. 동접 ~10명이 각자 1요청일 때 큐잉 없이 처리하도록 코어(8)보다 약간
#   높게 잡는다. 스레드 대부분이 S3/DB I/O 대기라 GIL 부담은 크지 않다.
#
# ── WEB_REPORT_COMPUTE_WORKERS / _ONDEMAND_WORKERS : 콜드 빌드 동시 처리 수 ──
#   콜드 빌드(세션 첫 조회 계산)를 돌리는 워커 프로세스 수와, 202 백그라운드 빌드를
#   집어가는 소비자 스레드 수. **둘은 짝으로 움직인다** — 풀만 늘리면 소비자 스레드
#   수가 새 상한이 되어 효과가 없다. 기본값(둘 다 2)에서 4 로 올린다: 2~3명이 서로
#   다른 세션을 동시에 처음 열면 3번째가 큐에서 대기했고, 업로드 프리웜·distpack 도
#   같은 풀을 쓰므로 겹치면 더 밀렸다.
#
#   **제약은 RAM 이 아니라 CPU 다** (실측: 유휴 워커 약 100MB, 아래 tables 상한 참고).
#   8코어 박스에 다른 서비스가 같이 도는 구성이라, 콜드 빌드가 4건 동시에 터지면 그
#   순간 4코어 + 부모 약 1코어를 쓴다. 콜드 빌드는 상시가 아니라 버스트(수 초~1분)이고
#   업로드 프리웜이 첫 조회 대부분을 미리 덮으므로 상시 점유는 아니다.
#   ※ _ONDEMAND_WORKERS 를 올릴 때의 숨은 비용: 부모 TABLES_CACHE 가 따뜻한 세션은
#     워커로 안 보내고 **부모에서 인라인** 빌드한다(should_offload=False). 즉 이 값이
#     크면 편집 직후 재빌드가 겹칠 때 부모 GIL 경합이 그만큼 늘 수 있다(건당 약 2초).
#   판단은 감이 아니라 관리자 현황 탭에서: "온디맨드 대기"가 상시 0 이면 4 가 과잉이고,
#   자주 1 이상이면 늘린 값이 실제로 일하고 있는 것이다. CPU 피크도 함께 볼 것.
#
# ── WEB_REPORT_TABLES_CACHE_MB : 프로세스당 decoded tables 캐시 바이트 상한 ───
#   기본 4096 → 2048 로 낮춘다. 이 캐시는 **부모와 워커가 각자** 갖고 상한 env 를
#   공유하므로, 값이 곧 "프로세스당 천장 x (1+워커수)" 다.
#   지금 데이터 규모(1500항목 x 2000행 x 10소스 = 세션당 약 229MB)에서는 개수 상한
#   (WEB_REPORT_TABLES_CACHE=4)이 먼저 걸려 4건 x 229MB = 약 0.9GB 이므로 2048 상한은
#   **발동하지 않는다 = 성능 손실 없음**. 훨씬 큰 데이터가 들어와도 프로세스당 2GB 로
#   묶여 전체 천장이 계산 가능해진다(부모 2 + 워커 4x2 = 10GB).
#
# 값을 바꾼 뒤에는 start.bat 을 다시 실행해야 반영된다.
# ============================================================================

HOST=0.0.0.0
PORT=8080
SERVER_BASE_URL=http://12.81.220.117:8080
WATCHDOG_MANAGE=1
# 사이드 진단 리스너 포트(127.0.0.1 전용, 스레드 덤프 채집용). 미설정 시 PORT+1 = 8081.
# 8081 이 이미 쓰이는 PC 에서만 다른 값으로 지정하고, 끄려면 DIAG_PORT=0.
#DIAG_PORT=8081
WAITRESS_THREADS=13
WEB_REPORT_COMPUTE_WORKERS=4
WEB_REPORT_ONDEMAND_WORKERS=4
WEB_REPORT_TABLES_CACHE_MB=2048
