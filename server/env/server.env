# ============================================================================
# report-server 기동 설정 — start.bat 과 watchdog.ps1 이 공통으로 읽는다.
# 여기가 정본이다. bat/ps1 안의 값을 고치지 말고 이 파일만 수정할 것.
#
#   형식 : KEY=VALUE   (값에 공백 금지 / '#' 로 시작하는 줄은 주석)
#   주의 : 반드시 BOM 없는 UTF-8 로 저장할 것.
#          (BOM 이 있으면 batch 가 첫 줄 키를 깨진 이름으로 읽는다)
#
# ── HOST : 서버가 bind 할 주소 ───────────────────────────────────────────────
#   0.0.0.0         이 PC 의 모든 IP 로 열기 (LAN 노출, 기본값)
#   12.81.220.117   운영 서버 IP 로만 열기
#                   ※ 그 IP 를 실제로 가진 PC 에서 실행할 때만 bind 된다.
#                      다른 PC 에서 이 값으로 두면 기동이 실패한다.
#   127.0.0.1       이 PC 에서만 접근 (로컬 전용, LAN 노출 없음)
#
# ── PORT : 수신 포트 ─────────────────────────────────────────────────────────
#   클라이언트(client/transport/config.py 의 SERVER_BASE_URL)와 맞춰야 한다.
#
# 값을 바꾼 뒤에는 start.bat 을 다시 실행해야 반영된다.
# ============================================================================

HOST=0.0.0.0
PORT=8080
