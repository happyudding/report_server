# ============================================================================
# report-server 기동 설정 — start.bat 과 watchdog.ps1 이 공통으로 읽는다.
# 여기가 정본이다. bat/ps1 안의 값을 고치지 말고 이 파일만 수정할 것.
#
#   형식 : KEY=VALUE   (값에 공백 금지 / '#' 로 시작하는 줄은 주석)
#   주의 : 반드시 BOM 없는 UTF-8 로 저장할 것.
#          (BOM 이 있으면 batch 가 첫 줄 키를 깨진 이름으로 읽는다)
#
# ── HOST : 서버가 bind 할 주소 ───────────────────────────────────────────────
#   0.0.0.0         이 PC 의 모든 IP 로 열기 (LAN 노출, 기본값)
#   12.81.220.117   운영 서버 IP 로만 열기
#                   ※ 그 IP 를 실제로 가진 PC 에서 실행할 때만 bind 된다.
#                      다른 PC 에서 이 값으로 두면 기동이 실패한다.
#   127.0.0.1       이 PC 에서만 접근 (로컬 전용, LAN 노출 없음)
#
# ── PORT : 수신 포트 ─────────────────────────────────────────────────────────
#   클라이언트(client/honey.env 의 HONEY_SERVER_URL)와 맞춰야 한다.
#
# ── SERVER_BASE_URL : 클라이언트가 실제로 접속하는 주소 ──────────────────────
#   HOST(=bind 주소)와 다른 값이다. HOST 는 "어느 랜카드로 들을지", 이 값은
#   "남들이 우리를 어떤 주소로 부르는지"다. 서버가 절대 URL 을 만들 때 쓴다.
#   운영 IP 가 바뀌면 이 값과 client/honey.env 의 HONEY_SERVER_URL 을 같이 고친다.
#
# ── WATCHDOG_MANAGE : start/terminate 가 watchdog 작업을 켜고 끌지 여부 ──────
#   1  (기본) terminate.bat 이 watchdog 을 잠시 끄고, start.bat 이 다시 켠다.
#             코드 교체 중 watchdog 이 옛 코드로 서버를 되살리는 것을 막는다.
#   0        watchdog 을 건드리지 않는다. 이 PC 에 watchdog 을 등록하지 않았거나,
#            schtasks 권한 문제로 메시지가 계속 거슬릴 때 사용.
#            ※ watchdog 자체를 끄는 게 아니라 "bat 이 관여하지 않는" 것이다.
#
# ── WAITRESS_THREADS : 동시에 처리할 요청 스레드 수 ──────────────────────────
#   기본 13 → **28** 로 올렸다(2026-08-12, 동접 ~30명 / 동시 세션 사용 ~15명 대응).
#   스레드 대부분이 S3/DB I/O 대기이고 파이썬 CPU 작업은 GIL 로 어차피 1개씩만 도므로
#   **코어 수와 직접 연동되는 값이 아니다** — 코어가 늘었다고 같이 올릴 값이 아니고,
#   콜드 빌드 동시성은 아래 워커 프로세스가 담당한다.
#   그런데도 올린 이유는 **접속자 수**다. 종전 13 은 "동접 ~10명이 각자 1요청" 전제인데,
#   세션 상세 1장을 여는 브라우저는 /full + distribution_batch + map_analysis + 이미지
#   여러 장을 **병렬로** 쏜다. 15명이 동시에 열면 in-flight 가 13 을 쉽게 넘고, 넘는
#   순간 뒤따르는 요청이 전부 큐에서 대기한다. 문제는 그 대기열에 **/healthz 도 같이
#   선다**는 것 — watchdog 이 healthz 응답을 30초 못 받으면 서버가 멀쩡한데도 죽은 줄
#   알고 재기동한다(사용 중 세션이 끊긴다). 스레드는 I/O 대기라 개당 비용이 거의 없으니
#   동접 수에 맞춰 넉넉히 잡는 편이 안전하다.
#   ※ 부수효과: 부모에서 인라인으로 도는 빌드(should_offload=False 경로)의 동시성도
#     같이 는다. 다만 부모는 단일 프로세스(GIL)라 CPU 점유는 1~2코어를 못 넘는다.
#     관리자 현황 탭에서 CPU·RSS 를 보고 과하면 20~24 로 낮추면 된다(env 1줄 + 재기동).
#
# ── WEB_REPORT_COMPUTE_WORKERS / _ONDEMAND_WORKERS : 콜드 빌드 동시 처리 수 ──
#   콜드 빌드(세션 첫 조회 계산)를 돌리는 워커 프로세스 수와, 202 백그라운드 빌드를
#   집어가는 소비자 스레드 수. **둘은 짝으로 움직인다** — 풀만 늘리면 소비자 스레드
#   수가 새 상한이 되어 효과가 없다. 기본값(둘 다 2) → 4 → **8** 로 올렸다(2026-08-06).
#   4 로 올린 이유: 2~3명이 서로 다른 세션을 동시에 처음 열면 3번째가 큐에서 대기했고,
#   업로드 프리웜·distpack 도 같은 풀을 쓰므로 겹치면 더 밀렸다. 다시 8 로 올린 이유:
#   (1) 운영 서버가 실제로 **16코어 / 64GB** 로 확인돼 아래 예산이 8코어 전제로 잘못
#   잡혀 있었고, (2) 슬롯 부족이 단순한 지연이 아니라 장애로 이어진다 —
#   WEB_REPORT_COMPUTE_TIMEOUT_SEC(300s)은 **풀 큐 대기까지 포함**해서 재므로, 밀려서
#   대기만 하다 타임아웃되면 _reset_pool(shutdown=True)이 **전 워커를 terminate** 해
#   동시에 돌던 빌드까지 BrokenProcessPool 로 함께 죽는다. 슬롯을 늘리면 그 방아쇠
#   (큐 대기)가 직접 줄어든다.
#
#   **제약은 RAM 이 아니라 CPU 다** (실측: 유휴 워커 약 100MB, 아래 tables 상한 참고).
#   박스는 16코어/64GB 이고 **다른 서버 2개가 같이 돈다** — 그래서 report-server 가 쓸
#   예산은 **실효 14코어 / 48GB 로 고정**해서 계산한다(2026-08-12 확인).
#   콜드 빌드가 8건 동시에 터지면 그 순간 8코어 + 부모 약 2코어를 쓰므로 실효 14 기준
#   10 을 쓰고 헤드룸이 4 남는다(동접 30 대응으로 워커 수는 8 유지).
#   콜드 빌드는 상시가 아니라 버스트(수 초~1분)이고 업로드 프리웜이 첫 조회 대부분을
#   미리 덮으므로 상시 점유는 아니다.
#   ※ _ONDEMAND_WORKERS 를 올릴 때의 숨은 비용: 부모 TABLES_CACHE 가 따뜻한 세션은
#     워커로 안 보내고 **부모에서 인라인** 빌드한다(should_offload=False). 즉 이 값이
#     크면 편집 직후 재빌드가 겹칠 때 부모 GIL 경합이 그만큼 늘 수 있다(건당 약 2초).
#     GIL 경합은 코어 수와 무관하므로 이 비용만은 16코어여도 그대로다.
#   판단은 감이 아니라 관리자 현황 탭에서: "온디맨드 대기"가 상시 0 이면 8 이 과잉이고,
#   자주 1 이상이면 늘린 값이 실제로 일하고 있는 것이다. CPU 피크도 함께 볼 것
#   (16코어이므로 전코어합 **1600% 만점**으로 읽는다 — 옛 800% 기준으로 보지 말 것).
#
# ── WEB_REPORT_TABLES_CACHE_MB : 프로세스당 decoded tables 캐시 바이트 상한 ───
#   기본 4096 → 2048 로 낮춘다. 이 캐시는 **부모와 워커가 각자** 갖고 상한 env 를
#   공유하므로, 값이 곧 "프로세스당 천장 x (1+워커수)" 다.
#   지금 데이터 규모(1500항목 x 2000행 x 10소스 = 세션당 약 229MB)에서는 개수 상한
#   (WEB_REPORT_TABLES_CACHE=4)이 먼저 걸려 4건 x 229MB = 약 0.9GB 이므로 2048 상한은
#   **발동하지 않는다 = 성능 손실 없음**. 훨씬 큰 데이터가 들어와도 프로세스당 2GB 로
#   묶여 전체 천장이 계산 가능해진다(부모 2 + 워커 8x2 = 18GB / 실효 48GB — 여유.
#   아래 조회 결과 캐시 약 4GB 를 더해도 이론 천장 22GB 로 절반 아래다).
#   워커를 8 로 올린 뒤에도 이 값은 그대로 둔다: 상한이 애초에 발동하지 않으므로 올려도
#   얻는 게 없고, 천장만 프로세스 수만큼 배로 커진다.
#
# ── 조회 결과 캐시 상한 (2026-08-06) ────────────────────────────────────────
#   REPORT/FULL/MAP/DIST_CHUNK 는 **부모 프로세스에만** 있는 조회 결과 캐시라
#   TABLES_CACHE 와 달리 워커 수만큼 배로 늘지 않는다. 기본값(8건/256MB 등)은 세션을
#   몇 개만 번갈아 열어도 LRU 로 밀려나 디스크 캐시 재적재(=json 재파싱)를 반복했다.
#   실효 48GB 중 합계 약 4GB 를 조회 캐시에 쓴다.
WEB_REPORT_REPORT_CACHE=32
WEB_REPORT_REPORT_CACHE_MB=1024
WEB_REPORT_FULL_CACHE=32
WEB_REPORT_FULL_CACHE_MB=1024
WEB_REPORT_MAP_CACHE=8
WEB_REPORT_MAP_CACHE_MB=1024
#   21 source 세션은 chunk 당 항목 수가 적어(adaptive_chunk_items) 개수 상한을 빨리 쓴다.
WEB_REPORT_DIST_CHUNK_CACHE=128
#
# ── 기동 후 재웜 스윕 (2026-08-06) ──────────────────────────────────────────
#   재기동·배포(캐시 스키마 버전 상승) 직후에는 전 세션이 콜드라 사용자 첫 조회가
#   전부 콜드 빌드로 몰린다. 기동 후 최근 세션을 유휴 워커로 미리 데워 그 폭풍을
#   서버가 대신 맞는다. 사용자 온디맨드 요청이 있으면 스윕은 양보한다.
#   끄려면 WEB_REPORT_REWARM_ON_START=0.
WEB_REPORT_REWARM_ON_START=1
WEB_REPORT_REWARM_LIMIT=30
WEB_REPORT_REWARM_DELAY_SEC=60
#
# ── 운영 경보 기준 (2026-08-12, 동접 30 대응) ───────────────────────────────
#   설정값이 아니라 **판단 기준**이다. 관리자 현황 탭에서 이 선을 넘으면 조치한다.
#   report-server 예산이 실효 14코어/48GB 라는 전제에서 나온 수치다.
#     RSS(부모+워커 합계)  경고 32GB / 임계 40GB → 넘으면 tables·조회 캐시 상한을 낮춘다
#     CPU(전코어합 1600% 만점)  85% 가 **지속**되면 과부하 → 워커 수를 낮춘다
#                               (버스트로 잠깐 튀는 것은 정상 — 콜드 빌드는 수 초~1분)
#     온디맨드 대기            30초 초과가 잦으면 워커 부족 (상시 0 이면 8 이 과잉)
#     watchdog 재기동 이력     healthz 지연으로 인한 재기동은 0 이어야 한다
#                               (0 이 아니면 WAITRESS_THREADS 부족을 먼저 의심)
#     DB lock 오류 카운터      증가하면 편집 저장 경합 — 관리자 화면에 노출된다
#
# ── LLM 배선 (EVAL_LLM_*) ───────────────────────────────────────────────────
#   **LLM 을 붙이는 곳은 여기 한 곳이다.** 아래 주석을 풀고 값만 채운 뒤 재기동하면
#   두 소비자가 함께 켜진다. 점검은 `python tools/llm_check.py --ping`.
#     ① 엔진 AI Comment — 이슈 코멘트의 [점검제안] 문장을 자연어로 합성
#        (eval_engine/llm_client.complete → pipeline/recommend.make_comment)
#     ② 웹 챗봇 — 질문을 어느 조회로 보낼지 분류 (chatbot/planner)
#   둘 다 **꺼져 있어도 동작한다** — ①은 룰 기반 문구, ②는 정규식·키워드 분류로 폴백한다.
#   LLM 은 문장 합성과 의도 분류에만 쓰고 수치·조회 결과는 항상 DB 에서 온다(환각 방지).
#
#   ENDPOINT 는 base URL(.../v1)과 완성 경로(.../v1/chat/completions) 둘 다 받는다.
#   그 외 경로는 준 그대로 POST 한다. shape 은 OpenAI 호환 chat completions.
#   모델명 하드코딩 금지 규약(eval_analyzer 규칙 #6)이라 값이 비면 그냥 꺼진 상태다.
#EVAL_LLM_ENABLED=true
#EVAL_LLM_ENDPOINT=http://사내-LLM-호스트:8000/v1
#EVAL_LLM_MODEL=모델명
#EVAL_LLM_API_KEY=필요할때만
#EVAL_LLM_TIMEOUT=30
#
# 값을 바꾼 뒤에는 start.bat 을 다시 실행해야 반영된다.
# ============================================================================

HOST=0.0.0.0
PORT=8080
SERVER_BASE_URL=http://12.81.220.117:8080
WATCHDOG_MANAGE=1
# 사이드 진단 리스너 포트(127.0.0.1 전용, 스레드 덤프 채집용). 미설정 시 PORT+1 = 8081.
# 8081 이 이미 쓰이는 PC 에서만 다른 값으로 지정하고, 끄려면 DIAG_PORT=0.
#DIAG_PORT=8081
WAITRESS_THREADS=28
WEB_REPORT_COMPUTE_WORKERS=8
WEB_REPORT_ONDEMAND_WORKERS=8
WEB_REPORT_TABLES_CACHE_MB=2048
# web_report 업로드 동시 처리 건수. 기본 2 → 3 (2026-08-13).
# 초과분은 즉시 거절이 아니라 WEB_REPORT_UPLOAD_WAIT_SEC 까지 대기하고,
# 대기열 상한은 WEB_REPORT_UPLOAD_MAX_WAITERS(4) 로 별도 유지한다
# (= 동시 3건 처리 + 4건 대기, 그 이상은 즉시 503).
WEB_REPORT_UPLOAD_CONCURRENCY=3
# 슬롯 대기 상한. 기본 180 → **90** (2026-08-19).
# 클라 업로드 read timeout 이 200초(client/transport/config.py WEBREPORT_UPLOAD_TIMEOUT_SEC)
# 로 내려왔는데 대기만 180초를 쓰면 ingest 를 시작하기도 전에 클라가 먼저 끊는다 —
# 그러면 사용자는 아무 안내도 못 받는다. 90초로 두면 밀렸을 때 **503 + Retry-After: 30**
# 이라는 행동 가능한 응답이 타임아웃보다 먼저 도착한다.
WEB_REPORT_UPLOAD_WAIT_SEC=90
# S3 read timeout(초). 기본 30 이면 이미지 프록시 1건이 재시도 3회 포함 최악 105초
# 동안 waitress 스레드를 잡는다(브라우저는 <img> 를 병렬로 쏘므로 S3 장애 시 13스레드
# 전멸 = 서버가 죽은 것처럼 보임). 8 로 줄여 최악 3x(5+8)=39초로 제한한다.
REPORT_S3_READ_TIMEOUT=8
# AI Comment 평가 범위. 1(기본)=fail 이 1chip 이상인 item 만 평가(Yield/Issue Table 과
# 같은 기준), 0=전체 item(종전 동작으로 복귀). item 컬럼만 줄이고 chip 행은 전량
# 유지하므로 분포·CPK 계산은 그대로다. 표본함 수집과 골든셋 검사는 이 값과 무관하게
# 항상 전체 item 을 본다. 바꾸면 서버 재기동 필요(ai_comment 세션 캐시 1회 재계산).
WEB_REPORT_EVAL_FAIL_ONLY=1
